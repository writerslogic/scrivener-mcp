diff --git a/tests/diagnostics.rs b/tests/diagnostics.rs
new file mode 100644
--- /dev/null
+++ b/tests/diagnostics.rs
@@ -0,0 +1,63 @@
+use std::{env, fs, path::Path, process::Command};
+
+#[test]
+fn invalid_inputs_report_source_diagnostics() {
+	let executable = env::current_exe().unwrap();
+	let dependencies = executable.parent().unwrap();
+	let prefix = format!("{}static_regular_grammar-", env::consts::DLL_PREFIX);
+	let artifacts: Vec<_> = fs::read_dir(dependencies)
+		.unwrap()
+		.map(|entry| entry.unwrap().path())
+		.filter(|path| {
+			path.file_name()
+				.unwrap()
+				.to_string_lossy()
+				.starts_with(&prefix)
+				&& path
+					.extension()
+					.is_some_and(|extension| extension == env::consts::DLL_EXTENSION)
+		})
+		.collect();
+	assert!(!artifacts.is_empty(), "compiled derive macro artifact");
+	let root = Path::new(env!("CARGO_MANIFEST_DIR"));
+	let output_dir = dependencies.join("diagnostic-fixtures");
+	fs::create_dir_all(&output_dir).unwrap();
+	for artifact in artifacts {
+		for (fixture, expected) in [
+			("invalid_inner_type", "invalid inner type"),
+			("malformed_grammar", "invalid ABNF grammar:"),
+		] {
+			let source = format!("tests/ui/{fixture}.rs");
+			let output = Command::new(env::var_os("RUSTC").unwrap_or_else(|| "rustc".into()))
+				.current_dir(root)
+				.env("CARGO_TARGET_DIR", &output_dir)
+				.env("CARGO_MANIFEST_DIR", root)
+				.env_remove("OUT_DIR")
+				.args(["--edition=2021", "--crate-type=lib", "--error-format=short"])
+				.arg("--extern")
+				.arg(format!("static_regular_grammar={}", artifact.display()))
+				.arg("--out-dir")
+				.arg(&output_dir)
+				.arg(&source)
+				.output()
+				.unwrap();
+			assert_eq!(
+				output.status.code(),
+				Some(1),
+				"{fixture} must fail to compile"
+			);
+			let diagnostics = String::from_utf8(output.stderr).unwrap();
+			assert!(diagnostics.contains(expected), "{diagnostics}");
+			assert!(!diagnostics.contains("panicked"), "{diagnostics}");
+			let source_location = if fixture == "invalid_inner_type" {
+				":4:20:"
+			} else {
+				":6:10:"
+			};
+			assert!(
+				diagnostics.contains(&format!("{source}{source_location}")),
+				"{diagnostics}"
+			);
+		}
+	}
+}
diff --git a/tests/validation.rs b/tests/validation.rs
new file mode 100644
--- /dev/null
+++ b/tests/validation.rs
@@ -0,0 +1,38 @@
+use static_regular_grammar::RegularGrammar;
+
+/// ```abnf
+/// word = 3*5%x61-7A
+/// ```
+#[derive(RegularGrammar)]
+#[grammar(ascii, sized(WordBuf))]
+pub struct Word([u8]);
+
+/// ```abnf
+/// moon = %x1F319
+/// ```
+#[derive(RegularGrammar)]
+pub struct Moon(str);
+
+#[test]
+fn grammar_bounds_and_owned_values_are_preserved() {
+	for (input, accepted) in [
+		(b"aa".as_slice(), false),
+		(b"aaa".as_slice(), true),
+		(b"aaaa".as_slice(), true),
+		(b"aaaaa".as_slice(), true),
+		(b"aaaaaa".as_slice(), false),
+		(b"a1a".as_slice(), false),
+	] {
+		assert_eq!(Word::new(input).is_ok(), accepted);
+		assert_eq!(WordBuf::new(input.to_vec()).is_ok(), accepted);
+	}
+	assert_eq!(Word::new(b"abc").unwrap().as_str(), "abc");
+}
+
+#[test]
+fn unicode_token_grammar_is_preserved() {
+	assert!(Moon::new("").is_err());
+	assert!(Moon::new("🌙").is_ok());
+	assert!(Moon::new("🌙🌙").is_err());
+	assert!(Moon::new("x").is_err());
+}
